PORT=3000
NODE_ENV=development

MONGO_URI=your_mongodb_connection_string

# Long random string, e.g. generate with: openssl rand -hex 64
JWT_SECRET=

# Only needed if you use the Google sign-in route
GOOGLE_CLIENT_ID=

# ============================================================
# EMAIL — pick ONE of the two methods below. OAuth2 is checked
# first; if those 4 vars are blank, generic SMTP is used instead.
# If neither is configured: dev mode logs to console, production
# mode refuses to start.
# ============================================================

# ---- Method 1: Gmail OAuth2 ----
# Setup steps:
#   1. console.cloud.google.com -> create/select a project
#   2. APIs & Services -> Library -> search "Gmail API" -> Enable
#   3. APIs & Services -> Credentials -> Create Credentials ->
#      OAuth Client ID -> type: Web application
#      Under "Authorized redirect URIs" add:
#        https://developers.google.com/oauthplayground
#      Save. Copy the Client ID and Client Secret it gives you.
#   4. Go to developers.google.com/oauthplayground
#   5. Click the gear icon (top right) -> check "Use your own OAuth
#      credentials" -> paste your Client ID + Client Secret
#   6. In the left panel, scroll to find "Gmail API v1" -> select
#      scope: https://mail.google.com/
#   7. Click "Authorize APIs" -> log in with the Gmail account you
#      want to send FROM -> allow access
#   8. Click "Exchange authorization code for tokens"
#   9. Copy the "Refresh token" shown -> that's GMAIL_OAUTH_REFRESH_TOKEN
#
GMAIL_USER=
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=

# ---- Method 2: Generic SMTP (simpler, used only if Method 1 is blank) ----
# Works with SendGrid, AWS SES, Mailgun, Postmark, or a Gmail App Password.
#
# SendGrid:      SMTP_HOST=smtp.sendgrid.net   SMTP_USER=apikey
# AWS SES:       SMTP_HOST=email-smtp.<region>.amazonaws.com
# Mailgun:       SMTP_HOST=smtp.mailgun.org
# Gmail (App Password, NOT your normal password):
#                SMTP_HOST=smtp.gmail.com
#
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="SevaSathi <no-reply@yourdomain.com>"
